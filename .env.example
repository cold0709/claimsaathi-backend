# ---- AI provider for bill reading (free option: Gemini) ----
# AI_PROVIDER=auto  -> uses Anthropic if its key is set, else Gemini, else sample/fallback
# AI_PROVIDER=gemini | anthropic to force one
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Value returned in "source" for Gemini results. The frontend contract only lists
# claude|sample|fallback. If the UI misbehaves on "gemini", set this to claude.
GEMINI_SOURCE_LABEL=gemini

# ---- Optional paid provider ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ---- App ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEMO_MODE=true
REQUIRE_AUTH=false
OTP_TTL_SECONDS=300
OTP_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# PDF_FONT_PATH=/path/to/NotoSansDevanagari-Regular.ttf